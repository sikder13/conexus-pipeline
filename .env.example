# Copy to .env and fill in. .env is gitignored — never commit it.
# Everything here is read exactly once, by lib/config.py. No other module
# touches the environment.

# --- Required. Tools refuse to start without these. ---

# Supabase project API URL, e.g. https://YOUR_PROJECT_REF.supabase.co
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Service role key, from Supabase dashboard -> Project Settings -> API.
# The schema enables row level security with no policies, so this is the only
# key that can read or write these tables. CLI-side only; it never reaches a
# browser. Treat it as a database password.
SUPABASE_SERVICE_ROLE_KEY=

# Contact address published in the outbound User-Agent on every fetch, so a
# site owner who notices us has a way to reach a human. Required: identifying
# the client honestly is a hard rule, not a setting.
CONTACT_EMAIL=

# --- Optional. Absent keys disable the feature that needs them. ---

# Needed by the Drafter. Without it, thesis drafting is unavailable.
ANTHROPIC_API_KEY=

# Needed for Crawlmouse audits, which are run manually per prospect.
CRAWLMOUSE_API_KEY=

# Federal Reserve Economic Data. Free from https://fredaccount.stlouisfed.org/
# apikeys. Without it the macro section of an analysis reports itself as not
# configured; it never fails the run.
FRED_API_KEY=

# Bureau of Labor Statistics. Free from https://data.bls.gov/registrationEngine/
# Without it the BLS series still work through the unregistered public API,
# which is capped at 25 queries a day and is reported as such.
BLS_API_KEY=

# --- Optional tunables. Defaults shown; uncomment only to override. ---

# Full User-Agent string, replacing the one built from CONTACT_EMAIL.
# USER_AGENT=

# Per-request timeout, seconds.
# REQUEST_TIMEOUT_SECONDS=20

# Pause between outbound fetches, seconds. Lowering this is a decision about
# someone else's server, so raise it before you lower it.
# FETCH_DELAY_SECONDS=2

# Where a compiled prospect dashboard will be served from, without a trailing
# slash. Optional: until the website repo has somewhere to host these, leave it
# unset and the QR codes carry a placeholder that cannot resolve, which is the
# honest state of it.
# NAHL_DASH_BASE=https://dashboards.nahltechnologies.com
